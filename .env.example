# Supabase — Auth + Postgres + RLS (ADR-0007, ADR-0013 phase 3)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Same values, exposed to the client bundle (Astro's PUBLIC_ convention) —
# the anon key is safe to expose by design, RLS is what protects data.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Service role — bypasses RLS entirely. Only used by scripts/seed-demo-data.ts
# to write on behalf of an arbitrary demo account. Never exposed to the app
# bundle or an endpoint — server-side script use only.
SUPABASE_SERVICE_ROLE_KEY=

# Groq — primary WorkoutPlanner (ADR-0005, ADR-0013 phase 3)
GROQ_API_KEY=

# Optional overrides — defaults are set in code (groq-planner.ts)
# GROQ_MODEL=
# GROQ_BASE_URL=

# OpenRouter — fallback WorkoutPlanner (ADR-0005, ADR-0013 phase 3)
OPENROUTER_API_KEY=

# Optional overrides — defaults are set in code (openrouter-planner.ts)
# OPENROUTER_MODEL=
# OPENROUTER_BASE_URL=

# Sentry — error monitoring (ADR-0019). Unset is the intended fail-open
# state for local dev: the SDK no-ops entirely with no DSN configured.
# Only the deployed Vercel environment needs this set.
# PUBLIC_SENTRY_DSN=

# Comma-separated user ids (not emails) for the publicly-credentialed demo
# account documented in README.md. Generations for these accounts never
# reach Groq/OpenRouter (deterministic planner only) and hard-stop at
# DEMO_DAILY_GENERATION_LIMIT/day instead of silently degrading. Not
# secret — PUBLIC_-prefixed on purpose, the client bundle uses it too for
# the on-screen demo-account banner (DemoBanner.svelte).
# PUBLIC_DEMO_USER_IDS=
