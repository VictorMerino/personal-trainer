# Supabase — Auth + Postgres + RLS (ADR-0007, ADR-0013 phase 3)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Groq — primary WorkoutPlanner (ADR-0005, ADR-0013 phase 3)
GROQ_API_KEY=

# Optional overrides — defaults are set in code (groq-planner.ts)
# GROQ_MODEL=
# GROQ_BASE_URL=

# OpenRouter — fallback WorkoutPlanner (ADR-0005, ADR-0013 phase 3)
OPENROUTER_API_KEY=

# Optional overrides — defaults are set in code (openrouter-planner.ts)
# OPENROUTER_MODEL=
# OPENROUTER_BASE_URL=
