{
  "name": "personal-trainer",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "test:e2e": "playwright test",
    "depcruise": "depcruise src",
    "depcruise:graph": "depcruise src --output-type dot | dot -T svg > docs/dependency-graph.svg",
    "secretlint": "secretlint --secretlintrc .secretlintrc.json '**/*'",
    "prepare": "husky",
    "db:seed": "tsx scripts/seed-demo-data.ts"
  },
  "dependencies": {
    "@astrojs/svelte": "^9.0.1",
    "@astrojs/vercel": "^11.0.4",
    "@sentry/astro": "^10.70.0",
    "@supabase/supabase-js": "^2.112.0",
    "astro": "^7.1.6",
    "svelte": "^5.56.8",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-svelte": "^3.22.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "secretlint": "^13.0.4",
    "tsx": "^4.23.5",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,ts,svelte,astro}": "eslint --fix",
    "*": "secretlint --secretlintrc .secretlintrc.json"
  }
}
