---
import Layout from '../../../shared/ui/Layout.astro';
import ChoiceScreen from '../../../features/workout-generation/ui/checkin/ChoiceScreen.svelte';

const { id } = Astro.params;
if (!id) return Astro.redirect('/checkin');
---

<Layout title="What's today?">
  <ChoiceScreen client:load checkInId={id} />
  <script>
    import { requireSignedIn } from '../../../shared/supabase/browser-client';

    requireSignedIn();
  </script>
</Layout>
