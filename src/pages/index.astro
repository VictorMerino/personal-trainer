---
import Navbar from '../shared/ui/landing/Navbar.astro';
import Hero from '../shared/ui/landing/Hero.astro';
import ProblemSection from '../shared/ui/landing/ProblemSection.astro';
import Interstitial from '../shared/ui/landing/Interstitial.astro';
import HowItWorks from '../shared/ui/landing/HowItWorks.astro';
import Loop from '../shared/ui/landing/Loop.astro';
import BadDay from '../shared/ui/landing/BadDay.astro';
import Guardrails from '../shared/ui/landing/Guardrails.astro';
import NoChatbot from '../shared/ui/landing/NoChatbot.astro';
import ProductSection from '../shared/ui/landing/ProductSection.astro';
import Footer from '../shared/ui/landing/Footer.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>Personal-TrAIner</title>
  </head>
  <body>
    <div class="page">
      <Navbar />
      <Hero />
      <ProblemSection />
      <Interstitial />
      <HowItWorks />
      <Loop />
      <BadDay />
      <Guardrails />
      <NoChatbot />
      <ProductSection />
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  :root {
    --ink: #f5f0e8;
    --ink-dim: rgba(245, 240, 232, 0.55);
    --ink-faint: rgba(245, 240, 232, 0.4);
    --bg: #181820;
    --card: #1e1e29;
    --accent: #f0b868;
    --accent-hover: #e0a050;
    --line: rgba(245, 240, 232, 0.08);
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
  }

  a {
    color: var(--ink);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
  }

  ::selection {
    background: rgba(240, 184, 104, 0.3);
  }

  .page {
    font-family: -apple-system, 'Helvetica Neue', Arial, sans-serif;
    background: var(--bg);
    overflow-x: hidden;
  }
</style>
