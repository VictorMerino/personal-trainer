---
import Layout from '../shared/ui/Layout.astro';
---

<Layout title="Personal-TrAIner">
  <p class="eyebrow">Personal-TrAIner</p>
  <h1>A workout plan that adapts to how you're actually doing.</h1>
  <p class="pitch">
    Tell it your goals and constraints, and it generates a workout for today. Check in
    afterward — how it felt, what you skipped — and tomorrow's plan adjusts accordingly.
  </p>

  <ol class="steps">
    <li>Set your goals, level, and equipment once.</li>
    <li>Get a workout generated for you each day.</li>
    <li>Check in after training, and the plan adapts from there.</li>
  </ol>

  <a href="/login" class="big-btn">Sign in</a>

  <p class="invite-note">
    Personal-TrAIner is currently invite-only while it's in early development — no public
    signup yet.
  </p>
</Layout>

<style>
  .eyebrow {
    margin: 0 0 var(--space-2);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }

  h1 {
    margin: 0 0 var(--space-4);
    font-size: 1.75rem;
    line-height: 1.25;
  }

  .pitch {
    margin: 0 0 var(--space-6);
    color: var(--ink-soft);
    font-size: 1.0625rem;
  }

  .steps {
    margin: 0 0 var(--space-7);
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    color: var(--ink);
  }

  .big-btn {
    display: block;
    width: 100%;
    box-sizing: border-box;
    font-family: var(--font-ui);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--paper-raised);
    background: var(--accent-strong);
    border: none;
    border-radius: var(--radius);
    padding: var(--space-5) var(--space-4);
    text-align: center;
    text-decoration: none;
    cursor: pointer;
  }

  .invite-note {
    margin: var(--space-5) 0 0;
    color: var(--ink-soft);
    font-size: 0.875rem;
    text-align: center;
  }
</style>
