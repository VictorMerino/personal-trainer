---
import CheckInScreen from '../shared/ui/landing/CheckInScreen.astro';
import WorkoutScreen from '../shared/ui/landing/WorkoutScreen.astro';
import OnboardingScreen from '../shared/ui/landing/OnboardingScreen.astro';
import LoggingScreen from '../shared/ui/landing/LoggingScreen.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>Personal-TrAIner</title>
  </head>
  <body>
    <div class="page">
      <!-- NAVBAR -->
      <div class="navbar">
        <div class="navbar-inner">
          <div class="wordmark">Personal-TrAIner</div>
          <div class="navlinks">
            <a href="#product">Product</a>
            <a href="#how-it-works">How it works</a>
            <a href="/login" class="btn-accent-sm">Get started</a>
          </div>
        </div>
      </div>

      <!-- HERO -->
      <div id="hero" class="section hero">
        <div class="hero-inner">
          <div>
            <div class="eyebrow accent">Your plan isn't fixed. Because you aren't either.</div>
            <div class="headline">Your training plan<br />adapts to you.</div>
            <div class="subhead">Your energy changes.<br />Your body changes.<br />Your schedule changes.</div>
            <p class="lede">
              Personal-TrAIner creates your workout based on how you're feeling today — and adapts what comes
              next based on how you actually trained.
            </p>
            <div class="cta-row">
              <a href="/login" class="btn-accent">Get started</a>
              <span class="fineprint">Currently invite-only.</span>
            </div>
          </div>
          <div class="hero-phones">
            <div class="phone-scale" style="width:140.8px;height:290.4px;">
              <div class="phone-scale-inner" style="transform:scale(0.44);"><CheckInScreen /></div>
            </div>
            <div class="arrow">→</div>
            <div class="phone-scale" style="width:140.8px;height:290.4px;">
              <div class="phone-scale-inner" style="transform:scale(0.44);"><WorkoutScreen /></div>
            </div>
          </div>
        </div>
      </div>

      <!-- PROBLEM -->
      <div class="section bordered">
        <div class="narrow center">
          <div class="eyebrow muted">The problem</div>
          <div class="h2">Most workout plans assume you'll feel fine.</div>
          <div class="stack-lines">
            <div>Some days you have plenty of energy.</div>
            <div>Some days you're exhausted.</div>
            <div>Sometimes something hurts.</div>
            <div>Sometimes you only have 20 minutes.</div>
          </div>
          <div class="divider-block">
            <div class="struck">Traditional plans tell you what you should do.</div>
            <div class="punch">Personal-TrAIner adapts to what you can actually do today.</div>
          </div>
        </div>
      </div>

      <!-- INTERSTITIAL -->
      <div class="section bordered tinted">
        <div class="medium center">
          <div class="big-quote">Your plan isn't fixed.<br /><span class="accent-text">Because you aren't either.</span></div>
        </div>
      </div>

      <!-- HOW IT WORKS -->
      <div id="how-it-works" class="section bordered">
        <div class="wide">
          <div class="narrow center section-head">
            <div class="eyebrow muted">How it works</div>
            <div class="h2">Your day becomes part of the plan.</div>
          </div>
          <div class="card-grid">
            <div class="card">
              <div class="icon-badge"><div class="icon-dot"></div></div>
              <div class="card-label">ENERGY</div>
              <div class="card-body">How ready do you feel?</div>
            </div>
            <div class="card">
              <div class="icon-badge"><div class="icon-diamond"></div></div>
              <div class="card-label">PAIN</div>
              <div class="card-body">Is something bothering you?</div>
            </div>
            <div class="card">
              <div class="icon-badge"><div class="icon-square"></div></div>
              <div class="card-label">TIME</div>
              <div class="card-body">How much time do you have?</div>
            </div>
            <div class="card">
              <div class="icon-badge"><div class="icon-rect"></div></div>
              <div class="card-label">EQUIPMENT</div>
              <div class="card-body">What can you train with?</div>
            </div>
          </div>
          <div class="center">
            <div class="h3">You don't need to explain yourself.</div>
            <div class="tag-row">
              <span class="tag">Tap</span>
              <span class="tag">Train</span>
              <span class="tag tag-accent">Check in</span>
            </div>
          </div>
        </div>
      </div>

      <!-- THE LOOP -->
      <div class="section bordered subtle-bg">
        <div class="medium center">
          <div class="eyebrow muted">The loop</div>
          <div class="h2">One plan.<br />Every day, different.</div>
          <div class="loop-row">
            <span class="loop-pill">CHECK IN</span>
            <span class="loop-arrow">→</span>
            <span class="loop-pill">GET YOUR WORKOUT</span>
            <span class="loop-arrow">→</span>
            <span class="loop-pill">TRAIN</span>
            <span class="loop-arrow">→</span>
            <span class="loop-pill">CHECK IN</span>
            <span class="loop-arrow">→</span>
            <span class="loop-pill loop-pill-accent">ADAPT</span>
          </div>
          <div class="lede-center">Every workout becomes information for the next one.</div>
        </div>
      </div>

      <!-- BAD DAY -->
      <div class="section bordered">
        <div class="medium">
          <div class="narrow center section-head">
            <div class="eyebrow muted">When plans break</div>
            <div class="h2">What happens when today doesn't go to plan?</div>
            <div class="stack-lines">
              <div>You planned to train.</div>
              <div>But your knee hurts.</div>
              <div class="dim">A rigid plan doesn't know what to do.</div>
              <div class="punch">Personal-TrAIner does.</div>
            </div>
          </div>
          <div class="card-grid three">
            <div class="card">
              <div class="card-label accent-text">LOW ENERGY</div>
              <div class="card-body-lg">Your session can be reduced.</div>
            </div>
            <div class="card">
              <div class="card-label accent-text">LIMITED BY PAIN</div>
              <div class="card-body-lg">Exercises that don't fit your current limitations are removed.</div>
            </div>
            <div class="card">
              <div class="card-label accent-text">NOT ENOUGH TIME</div>
              <div class="card-body-lg">Your workout can adapt to the time you actually have.</div>
            </div>
          </div>
          <div class="center punch-lg">Your plan adapts. You don't have to force it.</div>
        </div>
      </div>

      <!-- GUARDRAILS -->
      <div class="section bordered tinted">
        <div class="wide two-col">
          <div>
            <div class="eyebrow muted">Built on guardrails</div>
            <div class="h2">AI that works within your limits.</div>
            <p class="lede">Personal-TrAIner doesn't just ask AI to invent a workout.</p>
            <p class="lede">
              Your workouts are built from a curated exercise library and adapted to your current limitations.
            </p>
            <div class="h3">The AI helps choose the workout.<br />It doesn't define the rules.</div>
          </div>
          <div class="stack-pills">
            <span class="loop-pill">YOUR LIMITS</span>
            <div class="connector"></div>
            <span class="loop-pill">YOUR EXERCISES</span>
            <div class="connector"></div>
            <span class="loop-pill loop-pill-accent">YOUR WORKOUT</span>
          </div>
        </div>
      </div>

      <!-- NO CHATBOT -->
      <div class="section bordered">
        <div class="wide">
          <div class="narrow center section-head">
            <div class="eyebrow muted">No chat window</div>
            <div class="h2 small">Your personal trainer doesn't need a chat window.</div>
            <div class="stack-lines dim-lines">
              <div>No prompts.</div>
              <div>No endless conversations.</div>
              <div>No explaining how you're feeling to an AI.</div>
            </div>
            <div class="h3">Tap. Choose. Train.</div>
          </div>
          <div class="phone-row">
            <div class="phone-item">
              <div class="phone-scale" style="width:187.2px;height:403.2px;">
                <div class="phone-scale-inner" style="transform:scale(0.72);"><OnboardingScreen /></div>
              </div>
              <div class="phone-caption">Onboarding</div>
            </div>
            <div class="phone-item">
              <div class="phone-scale" style="width:176px;height:363px;">
                <div class="phone-scale-inner" style="transform:scale(0.55);"><CheckInScreen /></div>
              </div>
              <div class="phone-caption">Check-in</div>
            </div>
            <div class="phone-item">
              <div class="phone-scale" style="width:176px;height:363px;">
                <div class="phone-scale-inner" style="transform:scale(0.55);"><WorkoutScreen /></div>
              </div>
              <div class="phone-caption">Workout</div>
            </div>
            <div class="phone-item">
              <div class="phone-scale" style="width:187.2px;height:403.2px;">
                <div class="phone-scale-inner" style="transform:scale(0.72);"><LoggingScreen /></div>
              </div>
              <div class="phone-caption">Logging</div>
            </div>
          </div>
        </div>
      </div>

      <!-- PRODUCT + CLOSING -->
      <div id="product" class="section bordered subtle-bg">
        <div class="wide">
          <div class="narrow center section-head">
            <div class="eyebrow muted">The product</div>
            <div class="h2">Everything you need. Nothing you don't.</div>
          </div>
          <div class="card-grid">
            <div class="card">
              <div class="card-label">DAILY CHECK-IN</div>
              <div class="card-body">Know how you're doing today.</div>
            </div>
            <div class="card">
              <div class="card-label">ADAPTIVE WORKOUTS</div>
              <div class="card-body">A session built around your current state.</div>
            </div>
            <div class="card">
              <div class="card-label">WORKOUT LOGGING</div>
              <div class="card-body">Log sets, reps and RPE as you train.</div>
            </div>
            <div class="card">
              <div class="card-label">PROGRESS</div>
              <div class="card-body">See how your training evolves over time.</div>
            </div>
          </div>
          <div class="closing">
            <div class="h2">Real life doesn't follow a training plan.<br />So why should your training app?</div>
            <p class="lede-center">
              Personal-TrAIner adapts your training to how you're actually doing — today, and every day after.
            </p>
            <div class="cta-col">
              <a href="/login" class="btn-accent">Get started</a>
              <span class="fineprint">Currently invite-only.</span>
            </div>
          </div>
        </div>
      </div>

      <!-- FOOTER -->
      <div class="footer">
        <div class="footer-inner">
          <div>
            <div class="wordmark">Personal-TrAIner</div>
            <div class="footer-tagline">Adaptive training for real life.</div>
          </div>
          <div class="footer-links">
            <a href="#product">Product</a>
            <a href="#how-it-works">How it works</a>
            <a href="/login">Sign in</a>
          </div>
          <div class="footer-copy">© 2026 Personal-TrAIner</div>
        </div>
      </div>
    </div>
  </body>
</html>

<style>
  :root {
    --ink: #f5f0e8;
    --ink-dim: rgba(245, 240, 232, 0.55);
    --ink-faint: rgba(245, 240, 232, 0.4);
    --bg: #181820;
    --card: #1e1e29;
    --accent: #f0b868;
    --accent-hover: #e0a050;
    --line: rgba(245, 240, 232, 0.08);
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
  }

  a {
    color: var(--ink);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
  }

  ::selection {
    background: rgba(240, 184, 104, 0.3);
  }

  .page {
    font-family: -apple-system, 'Helvetica Neue', Arial, sans-serif;
    background: var(--bg);
    overflow-x: hidden;
  }

  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(24, 24, 32, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .navbar-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 18px clamp(24px, 5vw, 64px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .wordmark {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-weight: 700;
    font-size: 16px;
    color: var(--ink);
    letter-spacing: -0.01em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .navlinks {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .navlinks a:not(.btn-accent-sm) {
    font-size: 14.5px;
    font-weight: 500;
    color: var(--ink-dim);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .navlinks a:not(.btn-accent-sm) {
      display: none;
    }

    .navlinks {
      gap: 16px;
    }
  }

  .btn-accent,
  .btn-accent-sm {
    background: var(--accent);
    color: var(--bg);
    border-radius: 999px;
    font-weight: 700;
    display: inline-block;
  }

  .btn-accent:hover,
  .btn-accent-sm:hover {
    background: var(--accent-hover);
    color: var(--bg);
  }

  .btn-accent-sm {
    padding: 10px 22px;
    font-size: 14px;
  }

  .btn-accent {
    padding: 16px 34px;
    font-size: 16px;
  }

  .section {
    padding: 100px 0;
  }

  .section.bordered {
    border-top: 1px solid var(--line);
  }

  .section.tinted {
    background: rgba(240, 184, 104, 0.05);
  }

  .section.subtle-bg {
    background: rgba(255, 255, 255, 0.015);
  }

  .hero {
    padding: clamp(56px, 9vw, 108px) 0 100px;
  }

  .hero-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(24px, 5vw, 64px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 56px;
    align-items: center;
  }

  .eyebrow {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .eyebrow.accent {
    color: var(--accent);
    margin-bottom: 20px;
  }

  .eyebrow.muted {
    color: var(--ink-faint);
  }

  .headline {
    font-weight: 800;
    font-size: clamp(38px, 5vw, 58px);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .subhead {
    margin-top: 26px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-dim);
    font-weight: 500;
  }

  .lede {
    margin-top: 20px;
    font-size: 17px;
    line-height: 1.65;
    color: rgba(245, 240, 232, 0.55);
    max-width: 480px;
  }

  .lede-center {
    font-size: 19px;
    color: var(--ink-dim);
    font-weight: 500;
  }

  .cta-row {
    margin-top: 36px;
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .cta-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .fineprint {
    font-size: 14px;
    color: var(--ink-faint);
    font-weight: 500;
  }

  .hero-phones {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .phone-scale {
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
  }

  .phone-scale-inner {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: top left;
  }

  .arrow {
    font-size: 24px;
    color: rgba(245, 240, 232, 0.3);
    flex-shrink: 0;
  }

  .narrow {
    max-width: 780px;
    margin: 0 auto;
  }

  .medium {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 clamp(24px, 5vw, 64px);
  }

  .wide {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 clamp(24px, 5vw, 64px);
  }

  .narrow {
    padding: 0 clamp(24px, 5vw, 64px);
  }

  .center {
    text-align: center;
  }

  .section-head {
    max-width: 640px;
    margin: 0 auto 56px;
  }

  .h2 {
    font-weight: 800;
    font-size: clamp(28px, 3.6vw, 42px);
    line-height: 1.15;
    color: var(--ink);
    margin-bottom: 36px;
  }

  .h2.small {
    font-size: clamp(26px, 3.4vw, 38px);
    line-height: 1.18;
    margin-bottom: 22px;
  }

  .h3 {
    font-size: 22px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 14px;
  }

  .stack-lines {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 19px;
    color: var(--ink-dim);
    font-weight: 500;
    margin-bottom: 44px;
  }

  .stack-lines.dim-lines {
    font-size: 16.5px;
    color: rgba(245, 240, 232, 0.45);
    gap: 6px;
    margin-bottom: 22px;
  }

  .stack-lines .dim {
    color: rgba(245, 240, 232, 0.4);
  }

  .stack-lines .punch {
    color: var(--ink);
    font-weight: 700;
    font-size: 19px;
  }

  .divider-block {
    border-top: 1px solid rgba(245, 240, 232, 0.1);
    padding-top: 36px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .struck {
    font-size: 18px;
    color: rgba(245, 240, 232, 0.35);
    font-weight: 500;
    text-decoration: line-through;
    text-decoration-color: rgba(245, 240, 232, 0.2);
  }

  .punch {
    font-size: 22px;
    color: var(--ink);
    font-weight: 700;
  }

  .punch-lg {
    font-size: 21px;
    font-weight: 700;
    color: var(--ink);
  }

  .big-quote {
    font-weight: 800;
    font-size: clamp(30px, 4.2vw, 48px);
    line-height: 1.18;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .accent-text {
    color: var(--accent);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-bottom: 64px;
  }

  .card-grid.three {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 30px 26px;
  }

  .icon-badge {
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: rgba(240, 184, 104, 0.14);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  .icon-dot {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--accent);
  }

  .icon-diamond {
    width: 13px;
    height: 13px;
    background: var(--accent);
    transform: rotate(45deg);
  }

  .icon-square {
    width: 13px;
    height: 13px;
    border-radius: 3px;
    background: var(--accent);
  }

  .icon-rect {
    width: 15px;
    height: 9px;
    border-radius: 2px;
    border: 2.5px solid var(--accent);
  }

  .card-label {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-weight: 700;
    font-size: 12.5px;
    letter-spacing: 0.08em;
    color: var(--ink);
    margin-bottom: 10px;
  }

  .card-body {
    font-size: 15px;
    color: rgba(245, 240, 232, 0.55);
    line-height: 1.5;
  }

  .card-body-lg {
    font-size: 16px;
    color: rgba(245, 240, 232, 0.7);
    line-height: 1.5;
    font-weight: 500;
  }

  .tag-row {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .tag {
    background: rgba(245, 240, 232, 0.08);
    color: rgba(245, 240, 232, 0.7);
    padding: 10px 20px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 700;
  }

  .tag-accent {
    background: var(--accent);
    color: var(--bg);
  }

  .loop-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin: 56px 0 40px;
  }

  .loop-pill {
    background: var(--card);
    border: 1px solid rgba(245, 240, 232, 0.14);
    color: var(--ink);
    padding: 13px 22px;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .loop-pill-accent {
    background: var(--accent);
    color: var(--bg);
    border: none;
  }

  .loop-arrow {
    color: rgba(245, 240, 232, 0.3);
    font-size: 18px;
  }

  .two-col {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 56px;
    align-items: center;
  }

  .stack-pills {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .connector {
    width: 1px;
    height: 26px;
    background: rgba(245, 240, 232, 0.15);
  }

  .phone-row {
    display: flex;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: 56px;
  }

  .phone-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .phone-caption {
    font-size: 13px;
    font-weight: 600;
    color: rgba(245, 240, 232, 0.45);
  }

  .closing {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    border-top: 1px solid var(--line);
    padding-top: 90px;
  }

  .closing .h2 {
    margin-bottom: 24px;
  }

  .closing .lede-center {
    font-size: 18px;
    line-height: 1.6;
    color: rgba(245, 240, 232, 0.55);
    margin: 0 0 40px;
    display: block;
  }

