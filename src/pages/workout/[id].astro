---
import Layout from '../../shared/ui/Layout.astro';
import WorkoutSession from '../../features/workout-generation/ui/logger/WorkoutSession.svelte';

const { id } = Astro.params;
if (!id) return Astro.redirect('/checkin');
---

<Layout title="Today's workout">
  <WorkoutSession client:load planId={id} />
  <script>
    import { requireSignedIn } from '../../shared/supabase/browser-client';

    requireSignedIn();
  </script>
</Layout>
