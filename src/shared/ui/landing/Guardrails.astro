---
---

<div class="section bordered tinted">
  <div class="wide two-col">
    <div>
      <div class="eyebrow muted">Built on guardrails</div>
      <div class="h2">AI that works within your limits.</div>
      <p class="lede">Personal-TrAIner doesn't just ask AI to invent a workout.</p>
      <p class="lede">
        Your workouts are built from a curated exercise library and adapted to your current limitations.
      </p>
      <div class="h3">The AI helps choose the workout.<br />It doesn't define the rules.</div>
    </div>
    <div class="stack-pills">
      <span class="loop-pill">YOUR LIMITS</span>
      <div class="connector"></div>
      <span class="loop-pill">YOUR EXERCISES</span>
      <div class="connector"></div>
      <span class="loop-pill loop-pill-accent">YOUR WORKOUT</span>
    </div>
  </div>
</div>

<style>
  .section {
    padding: 100px 0;
  }

  .section.bordered {
    border-top: 1px solid var(--line);
  }

  .section.tinted {
    background: rgba(240, 184, 104, 0.05);
  }

  .wide {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 clamp(24px, 5vw, 64px);
  }

  .two-col {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 56px;
    align-items: center;
  }

  .eyebrow {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .eyebrow.muted {
    color: var(--ink-faint);
  }

  .h2 {
    font-weight: 800;
    font-size: clamp(28px, 3.6vw, 42px);
    line-height: 1.15;
    color: var(--ink);
    margin-bottom: 26px;
  }

  .lede {
    font-size: 17px;
    line-height: 1.65;
    color: rgba(245, 240, 232, 0.6);
    margin: 0 0 14px;
  }

  .h3 {
    font-size: 19px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.5;
  }

  .stack-pills {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .loop-pill {
    background: var(--card);
    border: 1px solid rgba(245, 240, 232, 0.14);
    color: var(--ink);
    padding: 14px 26px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .loop-pill-accent {
    background: var(--accent);
    color: var(--bg);
    border: none;
  }

  .connector {
    width: 1px;
    height: 26px;
    background: rgba(245, 240, 232, 0.15);
  }
</style>
