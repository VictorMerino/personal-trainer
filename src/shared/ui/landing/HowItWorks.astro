---
---

<div id="how-it-works" class="section bordered">
  <div class="wide">
    <div class="narrow center section-head">
      <div class="eyebrow muted">How it works</div>
      <div class="h2">Your day becomes part of the plan.</div>
    </div>
    <div class="card-grid">
      <div class="card">
        <div class="icon-badge"><div class="icon-dot"></div></div>
        <div class="card-label">ENERGY</div>
        <div class="card-body">How ready do you feel?</div>
      </div>
      <div class="card">
        <div class="icon-badge"><div class="icon-diamond"></div></div>
        <div class="card-label">PAIN</div>
        <div class="card-body">Is something bothering you?</div>
      </div>
      <div class="card">
        <div class="icon-badge"><div class="icon-square"></div></div>
        <div class="card-label">TIME</div>
        <div class="card-body">How much time do you have?</div>
      </div>
      <div class="card">
        <div class="icon-badge"><div class="icon-rect"></div></div>
        <div class="card-label">EQUIPMENT</div>
        <div class="card-body">What can you train with?</div>
      </div>
    </div>
    <div class="center">
      <div class="h3">You don't need to explain yourself.</div>
      <div class="tag-row">
        <span class="tag">Tap</span>
        <span class="tag">Train</span>
        <span class="tag tag-accent">Check in</span>
      </div>
    </div>
  </div>
</div>

<style>
  .section {
    padding: 100px 0;
  }

  .section.bordered {
    border-top: 1px solid var(--line);
  }

  .wide {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 clamp(24px, 5vw, 64px);
  }

  .narrow {
    max-width: 780px;
    margin: 0 auto;
  }

  .center {
    text-align: center;
  }

  .section-head {
    max-width: 640px;
    margin: 0 auto 56px;
  }

  .eyebrow {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .eyebrow.muted {
    color: var(--ink-faint);
  }

  .h2 {
    font-weight: 800;
    font-size: clamp(28px, 3.6vw, 42px);
    line-height: 1.15;
    color: var(--ink);
  }

  .h3 {
    font-size: 22px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 14px;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-bottom: 64px;
  }

  .card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 30px 26px;
  }

  .icon-badge {
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: rgba(240, 184, 104, 0.14);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  .icon-dot {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--accent);
  }

  .icon-diamond {
    width: 13px;
    height: 13px;
    background: var(--accent);
    transform: rotate(45deg);
  }

  .icon-square {
    width: 13px;
    height: 13px;
    border-radius: 3px;
    background: var(--accent);
  }

  .icon-rect {
    width: 15px;
    height: 9px;
    border-radius: 2px;
    border: 2.5px solid var(--accent);
  }

  .card-label {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-weight: 700;
    font-size: 12.5px;
    letter-spacing: 0.08em;
    color: var(--ink);
    margin-bottom: 10px;
  }

  .card-body {
    font-size: 15px;
    color: rgba(245, 240, 232, 0.55);
    line-height: 1.5;
  }

  .tag-row {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .tag {
    background: rgba(245, 240, 232, 0.08);
    color: rgba(245, 240, 232, 0.7);
    padding: 10px 20px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 700;
  }

  .tag-accent {
    background: var(--accent);
    color: var(--bg);
  }
</style>
