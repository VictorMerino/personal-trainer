  .medium {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 clamp(24px, 5vw, 64px);
  }

  .center {
    text-align: center;
  }

  .big-quote {
    font-weight: 800;
    font-size: clamp(30px, 4.2vw, 48px);
    line-height: 1.18;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .accent-text {
    color: var(--accent);
  }
</style>
