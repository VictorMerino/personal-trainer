---
import IosDevice from './IosDevice.astro';

const exercises: [string, string, boolean][] = [
  ['Goblet squat', '3 × 12', true],
  ['Incline row', '3 × 10', false],
  ['Step-up', '3 × 10', false],
  ['Plank', '3 × 40s', false],
];
---

<IosDevice width={320} height={660}>
  <div class="screen">
    <div class="header">
      <div class="eyebrow">EXERCISE 3 OF 4 · ADJUSTED FOR KNEE PAIN</div>
      <div class="title">Step-up</div>
      <div class="subtitle">Swapped for goblet squat — knee-friendly</div>
    </div>
    <div class="rep-card">
      <div class="rep-count">10 reps</div>
      <div class="rep-buttons">
        <div class="round-btn">–</div>
        <div class="round-btn">+</div>
      </div>
    </div>
    <div class="exercise-list">
      {
        exercises.map(([name, sets, done], i) => (
          <div class="exercise-row" class:list={{ 'no-border': i === exercises.length - 1 }}>
            <div class="exercise-name" class:list={{ done }}>
              {name}
            </div>
            <div class="exercise-sets">{sets}</div>
          </div>
        ))
      }
    </div>
    <div class="cta">
      <div class="btn">Log set</div>
    </div>
  </div>
</IosDevice>

<style>
  .screen {
    background: #f8f0e8;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding-top: 64px;
    font-family: -apple-system, 'Helvetica Neue', Arial, sans-serif;
  }

  .header {
    padding: 10px 22px 4px;
  }

  .eyebrow {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1px;
    color: rgba(24, 24, 32, 0.55);
    margin-bottom: 8px;
  }

  .title {
    font-size: 24px;
    font-weight: 800;
    color: #181820;
    line-height: 1.15;
  }

  .subtitle {
    font-size: 14px;
    color: rgba(24, 24, 32, 0.55);
    margin-top: 8px;
    font-weight: 500;
  }

  .rep-card {
    margin: 18px 22px 0;
    background: #fff;
    border: 1px solid rgba(24, 24, 32, 0.14);
    border-radius: 16px;
    padding: 14px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .rep-count {
    font-weight: 700;
    font-size: 15px;
    color: #181820;
  }

  .rep-buttons {
    display: flex;
    gap: 10px;
  }

  .round-btn {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1.5px solid rgba(24, 24, 32, 0.14);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    color: #181820;
  }

  .exercise-list {
    margin: 22px 22px 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .exercise-row {
    display: flex;
    justify-content: space-between;
    padding: 10px 4px;
    border-bottom: 1px solid rgba(24, 24, 32, 0.14);
  }

  .exercise-row.no-border {
    border-bottom: none;
  }

  .exercise-name {
    font-size: 14.5px;
    font-weight: 600;
    color: #181820;
  }

  .exercise-name.done {
    color: rgba(24, 24, 32, 0.55);
    text-decoration: line-through;
  }

  .exercise-sets {
    font-size: 13.5px;
    color: rgba(24, 24, 32, 0.55);
    font-weight: 600;
  }

  .cta {
    margin-top: auto;
    padding: 18px 22px;
  }

  .btn {
    background: #a46221;
    color: #fff;
    text-align: center;
    padding: 16px;
    border-radius: 14px;
    font-weight: 700;
    font-size: 15.5px;
  }
</style>
